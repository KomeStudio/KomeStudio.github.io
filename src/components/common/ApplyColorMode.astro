---
import { UI } from 'astrowind:config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme || 'system' }}>
  // Single source of truth for *applying* the color theme.
  function applyTheme(theme, mode) {
    document.documentElement.classList[theme === 'dark' ? 'add' : 'remove']('dark');
    document.documentElement.setAttribute('data-theme-mode', mode);
  }

  function resolveMode() {
    if (localStorage.theme === 'light' || localStorage.theme === 'dark') {
      return localStorage.theme;
    }
    return 'system';
  }

  function resolveTheme(mode) {
    if ((defaultTheme && defaultTheme.endsWith(':only')) || (!localStorage.theme && defaultTheme !== 'system')) {
      return defaultTheme.replace(':only', '');
    }
    if (mode === 'system') {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    return mode;
  }

  const initialMode = resolveMode();
  applyTheme(resolveTheme(initialMode), initialMode);

  // Listen to OS system color-scheme changes when in system mode
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    const currentMode = resolveMode();
    if (currentMode === 'system') {
      applyTheme(resolveTheme('system'), 'system');
      document.dispatchEvent(new CustomEvent('aw:theme-change'));
    }
  });

  // Keep re-applying the theme on view transitions
  document.addEventListener('astro:after-swap', () => {
    const currentMode = resolveMode();
    applyTheme(resolveTheme(currentMode), currentMode);
  });
</script>
